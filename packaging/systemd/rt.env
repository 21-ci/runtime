# Environment of the rt systemd unit (/etc/default/rt on Debian/Ubuntu, /etc/sysconfig/rt on Fedora/RHEL).
# This file holds secrets: keep it root-owned, mode 0600.
#
# Generate both values once:   openssl rand -hex 32
# The node refuses to start while either is empty or a placeholder. Keep a copy of the master key apart from the
# backups of /var/lib/rt: without it the sealed tenant secrets are unreadable.

# Bearer token of the control API (root scope).
RT_ROOT_TOKEN=
# 32 bytes as 64 hex chars: seals tenant secrets and derives the invoke MAC key.
RT_MASTER_KEY=

# Or point at files instead (set only one of NAME / NAME_FILE):
# RT_ROOT_TOKEN_FILE=/etc/rt/root-token
# RT_MASTER_KEY_FILE=/etc/rt/master.key

# Log filter (tracing syntax), e.g. info,rt_sched=debug
RT_LOG=info

# Any config key can be overridden: RT__SECTION__KEY=value, e.g.
# RT__NODE__DEFAULT_PROFILE=min_latency
