# Secrets for docker compose / scripts/docker-run.sh. Copy to `.env` (git-ignored) and replace BOTH values:
#
#   cp .env.example .env
#   sed -i.bak "s/^RT_ROOT_TOKEN=.*/RT_ROOT_TOKEN=$(openssl rand -hex 32)/; s/^RT_MASTER_KEY=.*/RT_MASTER_KEY=$(openssl rand -hex 32)/" .env && rm .env.bak
#
# or edit by hand and paste the output of `openssl rand -hex 32` (once per variable).
# `scripts/docker-run.sh` (make docker-run) generates a `.env` with fresh values when none exists.
# The node refuses to start with either `change-me-` placeholder below (the master key is not valid hex,
# the root token is refused by name), and scripts/docker-run.sh and scripts/e2e.sh refuse them too.
# A root token on a control listener that is not loopback-only must be at least 32 characters.

# Bearer token of the control API (root scope). Send it as `Authorization: Bearer <token>`.
RT_ROOT_TOKEN=change-me-8f3a1c5e97d2406b1ae0f7c3d95b28e41067a9cd3b5f82e1704ac6d9e3f05b72

# Master key: 32 bytes as 64 hex chars. It seals tenant secrets and derives the invoke MAC key.
# Lose it and every sealed secret in /data is unreadable; changing it is a re-keying operation.
RT_MASTER_KEY=change-me-2d7e90b4f1a6385c0e49d7b3a162f85c9e04b7d1a3f6285e0c94b7a1d3f8e6c0

# Optional: host ports (all bound to 127.0.0.1), log filter.
# RT_PUBLIC_PORT=8080
# RT_CONTROL_PORT=8081
# RT_METRICS_PORT=9090
# RT_LOG=info
# Image tag used by compose (default rt:dev).
# RT_IMAGE=rt:dev
