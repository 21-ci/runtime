# Normalise line endings: LF in the repository and in every checkout (scripts must run on Linux).
* text=auto eol=lf

*.sh       text eol=lf
*.rs       text eol=lf diff=rust
*.toml     text eol=lf
*.md       text eol=lf diff=markdown
*.ts       text eol=lf
*.js       text eol=lf
*.wit      text eol=lf
*.py       text eol=lf diff=python

# Binary artifacts
*.wasm     binary
*.cwasm    binary
*.png      binary
*.ico      binary
*.gz       binary
*.tgz      binary

# Generated or vendored: collapsed in diffs, excluded from language stats
Cargo.lock                                linguist-generated=true
openapi/openapi.json                      linguist-generated=true
config/schema.json                        linguist-generated=true
**/package-lock.json                      linguist-generated=true -diff
sample/wasm/js-componentize/wit/deps/**   linguist-vendored=true
fixtures/**                               linguist-vendored=false linguist-detectable=false
