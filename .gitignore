# Build output
target/
target-*/
*.cwasm
*.profraw
fixtures/wasm/out/

# JS / Python tooling
**/node_modules/
.pytest_cache/
__pycache__/
*.pyc
.venv/
site/

# Generated by scripts/docs_hooks.py on every docs build
/docs/assets/openapi.json

# Local node state and secrets (never commit these)
.env
.env.*
!.env.example
/rt.toml
/.config.old
/data/
/data-*/
/bench/data/
/bench/out/
/sample/apps/.smoke-data/
*.pem
*.key
!packaging/**/*.pub.key

# Editors and OS noise
.DS_Store
.idea/
.vscode/
*.swp
*~

# Claude Code per-user files (project skills in .claude/skills/ stay tracked)
.claude/settings.local.json
.claude/worktrees/
.claude/*.local.*
CLAUDE.local.md

# Release tooling output (CI builds these in dist/)
/dist/
